{
  "name": "old_portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "room:fetch": "node scripts/room/fetch.mjs",
    "room:textures": "python3 scripts/room/textures.py",
    "room:bake": "scripts/room/blender.sh --python scripts/room/build.py -- bake 4096 128",
    "room:compress": "npx -y @gltf-transform/cli@4.2.1 meshopt public/room/room.glb public/room/room.glb",
    "room": "npm run room:textures && npm run room:bake && npm run room:compress"
  },
  "dependencies": {
    "marked": "^18.1.3",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
